# AI法学日报 配置 —— 复制为 aidigest.env 后填写
# 服务器上实际文件在 /opt/aidigest/aidigest.env（600 权限）

# ===== 邮件（必填才能发信）=====
# 推荐 QQ 邮箱：网页版设置 → 账户 → 开启 SMTP 服务 → 获取授权码填到 SMTP_PASS
# 也可用 163 / 清华邮箱等任意 SMTP
MAIL_TO=me@example.com
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

MAIL_FROM_NAME=AI法学日报

# ===== 大模型（用于整理摘要，与律问共用同一把智谱 Key）=====
ZHIPU_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash

# ===== 抓取参数 =====
LOOKBACK_HOURS=30
MAX_ITEMS=22

# ===== 推特源（可选）=====
# 大陆服务器直连推特不通；若日后有 RSSHub/Nitter 等 RSS 地址，逗号分隔填这里即启用
TWITTER_RSS_URLS=
