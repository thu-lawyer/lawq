# ===== 大模型（必填其一，用于生成回答）=====
# 智谱开放平台 https://open.bigmodel.cn 注册即有免费额度
# 复制本文件为 .env 并填入你的 API Key
ZHIPU_API_KEY=

# 任意 OpenAI 兼容接口均可，下面两项可覆盖默认值
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.3-flash

# ===== 公网访问口令（强烈建议部署公网时设置）=====
# 留空 = 无需登录（仅限本地使用）。设置后网页与小程序均需先输入口令，token 7 天有效
ACCESS_PASSWORD=

# ===== 服务端口 =====
# LAWQ_PORT=8765
