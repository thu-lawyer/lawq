<view class="page">
  <view class="toolbar">
    <input class="input search" value="{{q}}" placeholder="搜索法律名 / 条文关键词…"
           placeholder-class="ph" bindinput="onSearch" confirm-type="search" />
  </view>

  <scroll-view scroll-x class="depts" enhanced show-scrollbar="{{false}}" wx:if="{{!searchMode}}">
    <view class="dept {{curDept === '' ? 'active' : ''}}" bindtap="onDept" data-d="">全部</view>
    <view class="dept {{curDept === item.name ? 'active' : ''}}" wx:for="{{depts}}" wx:key="name"
          bindtap="onDept" data-d="{{item.name}}">{{item.name}}</view>
  </scroll-view>

  <!-- 法律列表 / 搜索结果 -->
  <scroll-view scroll-y class="body" wx:if="{{!openLawId}}">
    <view class="head muted">{{headNote}}</view>
    <block wx:if="{{searchMode}}">
      <view class="art-card" wx:for="{{results}}" wx:key="id">
        <view class="no">{{item.shortName}} · {{item.articleNo}} <text class="badge ghost" wx:if="{{item.status !== '现行有效'}}">{{item.status}}</text></view>
        <view class="txt">{{item.text}}</view>
      </view>
      <view wx:if="{{!results.length}}" class="muted empty">没有匹配的条文</view>
    </block>
    <block wx:else>
      <view class="law-card" wx:for="{{laws}}" wx:key="law_id" bindtap="openLaw" data-id="{{item.law_id}}" data-name="{{item.law_name}}" data-status="{{item.status}}">
        <view class="law-name">{{item.law_name}}</view>
        <view class="badges">
          <text class="badge">{{item.law_department}}</text>
          <text class="badge ghost">{{item.doc_type}}</text>
          <text class="badge ghost">{{item.status}}</text>
          <text class="badge gold">现行 {{item.arts}} 条</text>
        </view>
        <view class="muted meta">{{item.issuing_body}} · 版本 {{item.version_date}}</view>
      </view>
      <view wx:if="{{!laws.length}}" class="muted empty">没有匹配的法律</view>
    </block>
    <view style="height:40rpx"></view>
  </scroll-view>

  <!-- 条文浏览 -->
  <scroll-view scroll-y class="body" wx:else>
    <view class="back" bindtap="closeLaw">← 返回列表</view>
    <view class="law-title">{{openLawName}}</view>
    <view class="art-card" wx:for="{{articles}}" wx:key="id">
      <view class="no">{{item.article_no}}
        <text class="badge ghost" wx:if="{{item.status !== '现行有效'}}">{{item.status}}</text>
        <text class="badge ghost" wx:if="{{item.chapter}}">{{item.chapter}}</text>
      </view>
      <view class="txt">{{item.article_text}}</view>
    </view>
    <view style="height:40rpx"></view>
  </scroll-view>
</view>
